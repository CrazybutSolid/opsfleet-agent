# --- LLM (Google AI Studio key: https://aistudio.google.com/apikey) ---
GOOGLE_API_KEY=
# Primary model and fallback model used on 429 / 5xx after backoff
OPSFLEET_MODEL=gemini-2.5-flash
OPSFLEET_FALLBACK_MODEL=gemini-2.5-flash-lite
# Client-side throttle to stay inside free-tier limits (requests per minute)
OPSFLEET_LLM_RPM=8

# --- BigQuery ---
# Project billed for query jobs (the public dataset itself is free to read; 1 TB/month free tier)
GOOGLE_CLOUD_PROJECT=
OPSFLEET_MAX_BYTES_BILLED=1000000000
OPSFLEET_MAX_ROWS=200

# --- Local state (SQLite + JSONL traces); default ./var ---
OPSFLEET_HOME=./var
